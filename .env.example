# DESTRUST10N Server Configuration
PORT=3000
NODE_ENV=development

# Configured Studio Contact
STUDIO_ALERT_EMAIL="destrust100n@gmail.com"

# --- PERSISTENT DATABASE STORAGE OPTIONS (Server-Side Only) ---

# Option A: Supabase PostgreSQL (Recommended for Vercel)
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Option B: Firebase Firestore (Alternative)
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# FIREBASE_API_KEY="your-firebase-web-api-key"

# --- EMAIL NOTIFICATIONS (Server-Side Only) ---
# Resend API Key for immediate email forwarding to destrust100n@gmail.com
# RESEND_API_KEY="re_123456789"

# --- CORS DOMAIN ALLOWLIST ---
ALLOWED_ORIGINS="https://destrust10n-website.vercel.app,https://destrust10n.com,https://www.destrust10n.com"
