# DESTRUST10N Server Configuration
PORT=3000
NODE_ENV=development

# Configured Studio Contact Email
STUDIO_ALERT_EMAIL="destrust100n@gmail.com"

# --- STUDIO OPERATIONS & ADMIN HUB (Server-Side Only) ---
# Master secret password for accessing the Studio Operations Hub (/admin or #admin)
ADMIN_SECRET_KEY="replace-with-a-random-secret-at-least-32-characters-long"

# --- PERSISTENT DATABASE: SUPABASE POSTGRESQL (Server-Side Only) ---
# Project URL and Secret Service Role Key from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# --- DISTRIBUTED RATE LIMITER: UPSTASH REDIS (Server-Side Only) ---
# REST URL and Token from Upstash Console -> Redis Database Details -> REST API
UPSTASH_REDIS_REST_URL="https://your-database-id.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# --- EMAIL NOTIFICATIONS: RESEND (Server-Side Only) ---
# Required for live inquiry alerts to destrust100n@gmail.com
RESEND_API_KEY="re_your_resend_api_key_here"
# Optional sender identity (Must be a domain verified in Resend Dashboard -> Domains, or default onboarding test sender)
# If using verified domain: RESEND_FROM_EMAIL="DESTRUST10N Studio <inquiries@destrust10n.com>"
# Default fallback: RESEND_FROM_EMAIL="DESTRUST10N Studio <onboarding@resend.dev>"
RESEND_FROM_EMAIL="DESTRUST10N Studio <onboarding@resend.dev>"

# --- CORS DOMAIN ALLOWLIST ---
ALLOWED_ORIGINS="https://destrust10n-website.vercel.app,https://destrust10n.com,https://www.destrust10n.com"
